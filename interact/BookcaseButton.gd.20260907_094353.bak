# Godot 4.x — Sabira / HOUSE
class_name BookcaseButton
extends Interactable
## Wall button that starts / stops the bookcase scrape-open.

@export var mover_path: NodePath = NodePath("../../Structure/BookcaseMover")

var _mover: Node3D


func _ready() -> void:
	collision_layer = 5  # world (1) + interactable (4)
	collision_mask = 0
	if mover_path != NodePath(""):
		_mover = get_node_or_null(mover_path)
	_update_prompt()
	if _mover and _mover.has_signal("state_changed"):
		_mover.state_changed.connect(_on_mover_state_changed)


func can_interact(_player: Node) -> bool:
	if not interact_enabled:
		return false
	if _mover == null:
		return false
	if _mover.has_method("is_fully_open") and _mover.is_fully_open():
		return false
	return true


func get_prompt() -> String:
	if not can_interact(null):
		return ""
	return prompt_text


func _on_interact(_player: Node) -> void:
	if _mover == null:
		return
	if _mover.has_method("toggle_or_stop"):
		_mover.toggle_or_stop()
	_update_prompt()


func _on_mover_state_changed(_state: int) -> void:
	_update_prompt()


func _update_prompt() -> void:
	if _mover == null:
		prompt_text = "[E] Move bookcase"
		return
	if _mover.has_method("is_fully_open") and _mover.is_fully_open():
		prompt_text = ""
		interact_enabled = false
		return
	interact_enabled = true
	if _mover.has_method("is_moving") and _mover.is_moving():
		prompt_text = "[E] Stop"
	else:
		prompt_text = "[E] Move bookcase"
